<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <!-- AppContextSwitchOverrides value attribute is in the form of 'key1=true|false;key2=true|false  -->
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=false;Switch.UseLegacyAccessibilityFeatures.2=false" />
  </runtime>
  <system.diagnostics>
    <switches>
      <add name="LogLevel" value="4" />
      <add name="SCTrace" value="4" />
    </switches>
    <sharedListeners>
      <!-- Define listener -->
      <add name="JobLog"
             type="Microsoft.Hpc.Trace.HpcTraceListener, Microsoft.Hpc.Trace"
             initializeData="%CCP_LOGROOT_USR%\JobManager\HpcJobManager" MultipleInstance="1" FileSizeMB="4" MaxAllowedDiskUsageInMB="100"/>
    </sharedListeners>

    <trace autoflush="true" indentsize="4" useGlobalLock="false">
      <listeners>
        <remove name="Default" />
        <add name="JobLog" />
      </listeners>
    </trace>
  
    <sources>
      <!--enable tracing for specific source-->
      <source name="HpcStoreApi" switchValue="All">
        <listeners>
          <remove name="Default" />
          <add name="JobLog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
</configuration>